flowchart TD
  AUTHUI["Settings > Providers"] --> AUTHAPI["GET/POST /api/chat/provider-auth"]
  AUTHAPI --> AUTHTARGET["Explicit configured runtime + provider"]
  AUTHTARGET --> AUTHREG["Capability dispatch through runtime registry/router"]
  AUTHREG -->|pi| PIAUTH["Pi adapter-owned AuthStorage flow"]
  AUTHREG -->|codex-native| CODEXAUTH["Private App Server account/* JSON-RPC"]
  PIAUTH --> AUTHRESULT["Pibo-owned per-runtime status/flow/result"]
  CODEXAUTH --> AUTHRESULT
  AUTHRESULT --> AUTHUI

  U["User types in Composer"] --> C{"Slash command?"}
  C -->|yes| ACTION["POST /api/chat/action"]
  C -->|no| MESSAGE["POST /api/chat/message"]

  ACTION --> WEB["Authenticated Chat Web API"]
  MESSAGE --> WEB
  WEB --> ACCEPT["Persist user.message.accepted and durable user message"]
  ACCEPT --> EMIT["channelContext.emit"]
  EMIT --> ROUTER["PiboSessionRouter.emit"]

  ROUTER --> ROUTED{"RoutedSession active?"}
  ROUTED -->|yes| QUEUE["enqueueMessage"]
  ROUTED -->|no| CREATE["createRoutedSession"]

  CREATE --> SESSION["Resolve Pibo Session + profile"]
  SESSION --> BINDING["Read/create frozen RuntimeSessionBinding"]
  BINDING --> INSTANCE["Resolve configured runtime instance"]
  INSTANCE --> GENERATION["Create live generation id"]
  GENERATION --> PTOOLS["Prepare selected portable Pibo tools"]
  GENERATION --> RESOURCES["Prepare selected skills, context, external MCP"]
  PTOOLS --> OPEN["AgentRuntimeDriver.openSession"]
  RESOURCES --> OPEN
  OPEN --> LIVE["AgentRuntimeSession + effective capabilities"]
  LIVE --> CAS["Persist native id/state with binding CAS"]
  CAS --> QUEUE

  QUEUE --> MQ["Emit message_queued"]
  QUEUE --> DRAIN["Drain one active message"]
  DRAIN --> MS["Emit message_started"]
  MS --> PROMPT["AgentRuntimeSession.prompt"]

  PROMPT --> ADAPTER{"Frozen adapter"}
  ADAPTER -->|pi| PI["Pi adapter"]
  PI --> PISDK["Pi AgentSession.prompt / native Pi loop"]
  PISDK --> PIPROVIDER["Pi provider stream + Pi/native direct tools"]

  ADAPTER -->|codex-native| CODEX["Codex-native adapter"]
  CODEX --> APP["Private Codex App Server 0.147.x"]
  APP --> TURN["turn/start JSON-RPC"]
  TURN --> CODEXLOOP["Native Codex model loop + standard tools"]
  CODEXLOOP --> MCP["Selected Pibo/external MCP + isolated skills/context"]

  PIPROVIDER --> SEMANTIC["AgentRuntimeSemanticEvent"]
  MCP --> SEMANTIC
  SEMANTIC --> CORRELATE["RoutedSession correlates Pibo ids, indices, requests, terminal state"]
  CORRELATE --> OUTPUT["PiboOutputEvent"]

  OUTPUT --> ROUTOUT["PiboSessionRouter.emitOutput"]
  ROUTOUT --> HISTORY[("pibo.sqlite: messages, events, payload refs")]
  ROUTOUT --> TELEMETRY[("telemetry + signals")]
  ROUTOUT --> RELIABILITY[("reliability state")]
  ROUTOUT --> SSE["/api/chat/events SSE"]
  SSE --> UI["Chat UI reconciles live trace"]

  CODEXLOOP --> SUBAGENT{"pibo_subagent tool?"}
  PIPROVIDER --> SUBAGENT
  SUBAGENT -->|yes| CHILD["Create/reuse child Pibo Session"]
  CHILD --> CHILDBIND["Child freezes target profile binding"]
  CHILDBIND --> ROUTER

  PROMPT --> REQUEST{"Approval / structured input?"}
  REQUEST -->|supported| PENDING["Bounded pending request in API/UI"]
  PENDING --> RESOLVE["Resolve at most once"]
  RESOLVE --> PROMPT

  PROMPT --> FAILURE{"Abort, crash, or missing native state?"}
  FAILURE -->|abort| INTERRUPT["Interrupt + bounded cleanup; Codex recycles App Server"]
  FAILURE -->|provider/protocol| ERROR["Normalized session_error; one terminal outcome"]
  FAILURE -->|missing| MISSING["Persist missing binding; keep product history; no replacement"]

  INTERRUPT --> CLEANUP["Revoke credentials, cancel active child work, remove generation files"]
  ERROR --> CLEANUP
  MISSING --> CLEANUP
