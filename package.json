    },
    "./plugin-builtin/file-editing": {
      "types": "./dist/plugins/packaged-file-editing.d.ts",
      "import": "./dist/plugins/packaged-file-editing.js"
    },
    "./plugin-builtin/web-search": {
      "types": "./dist/plugins/packaged-web-search.d.ts",
      "import": "./dist/plugins/packaged-web-search.js"
    },
    "./plugin-builtin/browser-tools": {
      "types": "./dist/plugins/packaged-browser-tools.d.ts",
      "import": "./dist/plugins/packaged-browser-tools.js"
    },
    "./plugin-builtin/gateway-tools": {
      "types": "./dist/plugins/packaged-gateway-tools.d.ts",
      "import": "./dist/plugins/packaged-gateway-tools.js"
    },
    "./plugin-builtin/codex-compat": {
      "types": "./dist/plugins/packaged-codex-compat.d.ts",
      "import": "./dist/plugins/packaged-codex-compat.js"
    },
    "./plugin-builtin/tool-families": {
      "types": "./dist/plugins/packaged-tool-families.d.ts",
      "import": "./dist/plugins/packaged-tool-families.js"
    },
    "./plugin-builtin/run-control": {
      "types": "./dist/plugins/packaged-run-control.d.ts",
      "import": "./dist/plugins/packaged-run-control.js"
    },
    "./plugin-builtin/goal-loops": {
      "types": "./dist/plugins/packaged-goal-loops.d.ts",
      "import": "./dist/plugins/packaged-goal-loops.js"
    },
    "./plugin-builtin/agent-delegation": {
      "types": "./dist/plugins/packaged-agent-delegation.d.ts",
      "import": "./dist/plugins/packaged-agent-delegation.js"
    },
    "./plugin-builtin/control-tools": {
      "types": "./dist/plugins/packaged-control-tools.d.ts",
      "import": "./dist/plugins/packaged-control-tools.js"
    },
    "./plugin-builtin/runtime-pi": {
      "types": "./dist/plugins/packaged-runtime-pi.d.ts",
      "import": "./dist/plugins/packaged-runtime-pi.js"
    },
    "./plugin-builtin/runtime-codex-native": {
      "types": "./dist/plugins/packaged-runtime-codex-native.d.ts",
      "import": "./dist/plugins/packaged-runtime-codex-native.js"
    },
    "./plugin-builtin/runtime-omp": {
      "types": "./dist/plugins/packaged-runtime-omp.d.ts",
      "import": "./dist/plugins/packaged-runtime-omp.js"
    },
    "./plugin-builtin/runtime-adapters": {
      "types": "./dist/plugins/packaged-runtime-adapters.d.ts",
      "import": "./dist/plugins/packaged-runtime-adapters.js"
    },
    "./plugin-builtin/profiles": {
      "types": "./dist/plugins/packaged-profiles.d.ts",
      "import": "./dist/plugins/packaged-profiles.js"
    },
    "./plugin-builtin/mcp-cli": {
      "types": "./dist/plugins/packaged-mcp-cli.d.ts",
      "import": "./dist/plugins/packaged-mcp-cli.js"
    },
    "./plugin-builtin/product-ui": {
      "types": "./dist/plugins/packaged-product-ui.d.ts",
      "import": "./dist/plugins/packaged-product-ui.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "workspaces": [
    "packages/workflows"
  ],
  "description": "Minimal TypeScript wrapper around Pi Coding Agent.",
  "files": [
    "dist",
    "!dist/apps/chat-vscode-web/**",
    "!dist/apps/cli-ui/**",
    "!dist/cli-session/**",
    "!dist/local/**",
    "!dist/pi-packages/**",
    "!dist/plugins/chat-vscode-web.*",
    "!dist/vscode/**",
    "packages/workflows/dist",
    "!packages/workflows/dist/testing/**",
    "packages/workflows/package.json",
    "context",
    "skills/builtin/**",
    "docs/project/operations/**",
    "!docs/project/operations/index.md",
    "!docs/project/operations/vscode-extension-release.md",
    "docs/project/installation-profiles.md",
    "docs/project/guides/pibo-on-windows-via-wsl.md",
    "!docs/README.md",
    "!docs/project/README.md",
    "README.md",
    "src/mcp/LICENSE.mcp-cli",
    "npm-shrinkwrap.json",
    "compute-image/Dockerfile",
    "compute-image/Dockerfile.dockerignore",
    "scripts/docker-entrypoint.sh",
    "scripts/prepare-browser-use-wrapper.sh",
    "scripts/prepare-agent-browser-wrapper.sh"
  ],
  "bin": {
    "pibo": "dist/bin/pibo.js",
    "rg": "dist/bin/rg.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/bin/pibo.ts",
    "profile": "tsx src/bin/pibo.ts profile",
    "gateway": "tsx src/bin/pibo.ts gateway",
    "gateway:web": "npm run web-ui:build && tsx src/bin/pibo.ts gateway:web",
    "client": "tsx src/bin/pibo.ts client",
    "chat-ui:build": "vite build --config src/apps/chat-ui/vite.config.ts",
    "chat-ui:typecheck": "tsc -p src/apps/chat-ui/tsconfig.json --noEmit",
    "context-files-ui:build": "vite build --config src/apps/context-files-ui/vite.config.ts",
    "context-files-ui:typecheck": "tsc -p src/apps/context-files-ui/tsconfig.json --noEmit",
    "web-ui:build": "npm run chat-ui:build && npm run context-files-ui:build",
    "workflows:build": "npm run build --workspace @pasko70/pibo-workflows",
    "workflows:typecheck": "npm run typecheck --workspace @pasko70/pibo-workflows",
    "release": "node scripts/release.mjs",
    "release:github": "node scripts/create-github-release.mjs",
    "build": "npm run clean && npm run workflows:build && node --max-old-space-size=1200 node_modules/typescript/bin/tsc -p tsconfig.json && npm run plugins:sdk:build && npm run web-ui:build && node scripts/ensure-bin-executable.mjs",
    "start": "node dist/bin/pibo.js",
    "test": "npm run build && node scripts/run-test-suite.mjs",
    "docs:validate": "npm run docs:validate:strict",
    "docs:validate:okf": "node scripts/validate-okf-docs.mjs --mode core",
    "docs:validate:migration": "node scripts/validate-okf-docs.mjs --mode migration",
    "docs:validate:strict": "node scripts/validate-okf-docs.mjs --mode strict",
    "docs:indexes:write": "node scripts/generate-okf-indexes.mjs",
    "docs:indexes:check": "node scripts/generate-okf-indexes.mjs --check",
    "docs:log:check": "node scripts/check-okf-log.mjs",
    "docs:validator:test": "node --test test/okf-validator.test.mjs test/okf-authoring-guidance.test.mjs",
    "check:product-vocab": "node scripts/legacy-product-vocabulary-gate.mjs",
    "compute:limited-worker-smoke": "node scripts/compute-limited-worker-smoke.mjs",
    "validate:goal-endurance": "node scripts/goal-endurance-check.mjs",
    "typecheck": "npm run workflows:typecheck && node --max-old-space-size=1200 node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && npm run chat-ui:typecheck && npm run context-files-ui:typecheck",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build && node scripts/package-shrinkwrap.mjs prepare",
    "postpack": "node scripts/package-shrinkwrap.mjs clean",
    "plugins:sdk:build": "node --max-old-space-size=1200 node_modules/typescript/bin/tsc -p tsconfig.plugin-sdk.json && node scripts/write-plugin-builtin-declarations.mjs",
    "pibo4:artifacts": "node scripts/build-pibo4-artifacts.mjs",
    "pibo4:minimal-core": "node scripts/build-pibo4-minimal-core.mjs",
    "pibo4:packages": "npm run pibo4:artifacts && npm run pibo4:minimal-core"
  },
  "dependencies": {
    "@balena/dockerignore": "1.0.2",
    "@earendil-works/pi-agent-core": "0.85.0",
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@uiw/react-json-view": "^2.0.0-alpha.41",
    "@vscode/ripgrep": "^1.18.0",
    "@xyflow/react": "12.10.2",
    "acorn": "8.16.0",
    "acorn-walk": "8.3.4",
    "better-auth": "1.6.30",
    "commander": "^14.0.3",
    "lexical": "^0.35.0",
    "lucide-react": "^0.545.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.6",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.4",
    "tiktoken": "^1.0.22",
    "typebox": "1.1.38",
    "xstate": "5.31.1"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "js-yaml": "4.3.1"
  },
  "devDependencies": {
    "@mdxeditor/editor": "^3.55.0",
    "@tanstack/router-plugin": "^1.167.28",
    "@types/node": "^25.6.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "react-test-renderer": "19.2.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^5.1.4",
    "yaml": "^2.9.0"
  }
}
