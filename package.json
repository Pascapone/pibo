      "import": "./dist/plugins/host.js"
    },
    "./plugin-runtime": {
      "types": "./dist/plugins/runtime.d.ts",
      "import": "./dist/plugins/runtime.js"
    },
    "./plugin-cutover": {
      "types": "./dist/plugins/cutover.d.ts",
      "import": "./dist/plugins/cutover.js"
    },
    "./plugin-builtin/core": {
      "types": "./dist/plugins/packaged-core.d.ts",
      "import": "./dist/plugins/packaged-core.js"
    },
    "./plugin-builtin/preview": {
      "types": "./dist/plugins/packaged-preview.d.ts",
      "import": "./dist/plugins/packaged-preview.js"
    },
    "./plugin-builtin/cron": {
      "types": "./dist/plugins/packaged-cron.d.ts",
      "import": "./dist/plugins/packaged-cron.js"
    },
    "./plugin-builtin/workflows": {
      "types": "./dist/plugins/packaged-workflows.d.ts",
      "import": "./dist/plugins/packaged-workflows.js"
    },
    "./plugin-builtin/user-resources": {
      "types": "./dist/plugins/packaged-user-resources.d.ts",
      "import": "./dist/plugins/packaged-user-resources.js"
    },
    "./plugin-builtin/transcription-openai-chatgpt": {
      "types": "./dist/plugins/packaged-transcription-openai-chatgpt.d.ts",
      "import": "./dist/plugins/packaged-transcription-openai-chatgpt.js"
    },
    "./plugin-builtin/transcription-openai": {
      "types": "./dist/plugins/packaged-transcription-openai.d.ts",
      "import": "./dist/plugins/packaged-transcription-openai.js"
    },
    "./plugin-builtin/transcription": {
      "types": "./dist/plugins/packaged-transcription.d.ts",
      "import": "./dist/plugins/packaged-transcription.js"
    },
    "./plugin-builtin/web-annotations": {
      "types": "./dist/plugins/packaged-web-annotations.d.ts",
      "import": "./dist/plugins/packaged-web-annotations.js"
    },
    "./plugin-builtin/code-runtime": {
      "types": "./dist/plugins/packaged-code-runtime.d.ts",
